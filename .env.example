# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Business Central connection -----------------------------------------
# BC_ACCESS_KEY is the Web Service Access Key from the Business Central user
# card (User Settings -> Users -> your user -> Web Service Access Key), NOT
# your Windows/AD password. Generate one there if the field is empty.
BC_USERNAME=
BC_ACCESS_KEY=

# OData v4 root, without a trailing slash.
BC_BASE_URL=http://20.235.106.184:8058/ERP/ODataV4

# Company display name, unencoded. The client URL-encodes it.
BC_COMPANY=NUTASTE FOOD & DRINK LABS (P)

# Seconds per HTTP request. Raise to 300 if the archive endpoint is stalling.
BC_TIMEOUT=180

# --- Output locations ------------------------------------------------------
# Leave OUTPUT_DIR blank to write Excel to ./output.
# Point PARQUET_DIR at a OneDrive/SharePoint-synced folder so Power BI can
# refresh from the cloud without a gateway. See README "Power BI".
OUTPUT_DIR=
PARQUET_DIR=

# --- Behaviour -------------------------------------------------------------
# Include live, not-yet-archived sales order lines. Keep this TRUE: with it off,
# a line only enters the report once its order closes, which lets an already
# published month keep changing. See README "A closed month must not move".
INCLUDE_OPEN_ORDERS=true

# Keep a dated copy of each run under <PARQUET_DIR>/history for trending.
KEEP_HISTORY=true

# Restrict month-by-month OTIF to lines whose deadline has actually arrived.
# Leave true; see README "OTIF is only assessable once the deadline passes".
SNOP_REQUIRE_ELAPSED_DEADLINE=true

# Optional: only pull order lines with a requested delivery date on/after this
# many days ago. Blank means a full pull.
LOOKBACK_DAYS=

# Escape hatch only: skip ArchiveSalesOrdeLinesBi when that endpoint is down.
# Implies INCLUDE_OPEN_ORDERS. Drastically changes the population -- smoke test
# only, never a real report.
SKIP_ARCHIVE_LINES=false
